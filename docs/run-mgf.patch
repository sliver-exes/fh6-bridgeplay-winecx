> # MGF: native Microsoft VC++ runtime first (Highball tweak concrt140-native: Wine's builtin concrt140
> # concurrent_vector race crashes FH6, FHE21). Same list as the FH-fex tool. Credit: Highball/highball-db.
> # MGF: LAUNCH-OPTION DEFAULTS. Bridgeplay's hook passes launch options as environment variables (`VAR=value %command%`, run through
> # MGF: /bin/sh). Every value this tool sets itself goes through opt_default (or ${VAR:-default}), so a launch option always wins; an empty
> # MGF: value counts as not set. The log (graphics: lines in bridgeplay-run.log) says "<VAR> from launch options" or "<VAR> default".
> opt_default() {
>   eval "opt_cur=\${$1:-}"
>   if [ -n "$opt_cur" ]; then
>     graphics_log "$1 from launch options: $opt_cur"
>   else
>     export "$1=$2"
>     graphics_log "$1 default: $2"
>   fi
> }
> # MGF: DLL overrides compose, they do not replace. Order in WINEDLLOVERRIDES: backend, this tool's defaults, the gamefix conf, then the
> # MGF: launch options (WINEDLLOVERRIDES=..., or BRIDGEPLAY_DLLOVERRIDES=..., which is appended after it). Wine takes the LAST entry for a
> # MGF: DLL, so the launch options win per DLL and every other default stays: BRIDGEPLAY_DLLOVERRIDES='concrt140=b' only touches concrt140.
> if [ -n "${BRIDGEPLAY_DLLOVERRIDES:-}" ]; then
>   WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}$BRIDGEPLAY_DLLOVERRIDES"
>   graphics_log "BRIDGEPLAY_DLLOVERRIDES from launch options (wins per DLL): $BRIDGEPLAY_DLLOVERRIDES"
