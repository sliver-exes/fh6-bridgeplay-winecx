+static int socket_family(SOCKET socket)
+{
+    int i, family = -1;
+    if (!socket || socket == INVALID_SOCKET) return -1;
+    AcquireSRWLockShared(&socket_lock);
+    for (i = 0; i < MAX_SOCKETS; i++) if (sockets[i].socket == socket) { family = sockets[i].family; break; }
